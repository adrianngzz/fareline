# Test chat
COMMUTE_PORT=47291
COMMUTE_DB_PATH=data/commute.db

# Photon Spectrum, Stable SDK. The test chat runs without these.
# Project settings: https://photon.codes/docs/spectrum-ts/getting-started
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# JSON object of iMessage sender id -> rider name
SPECTRUM_SENDER_MAP={"+15551234567":"Adrian"}
COMMUTE_API_URL=http://127.0.0.1:47291

# Fetch.ai Agentverse. The test chat runs without these.
# https://innovationlab.fetch.ai/resources/docs/examples/chat-protocol/asi-compatible-uagents
AGENT_SEED=
UAGENT_PORT=8011
# JSON object of ASI:One / agent address -> rider name
FETCH_SENDER_MAP={"agent1q...":"Adrian"}
# Optional. Only used when a line does not match the ledger grammar.
ASI1_API_KEY=
